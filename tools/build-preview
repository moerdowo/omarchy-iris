#!/usr/bin/env bash
# Draw the repository's two picture sheets: preview.png and docs/tempers.png.
#
# These are the only images the project ships, and both are drawn by the SHELL'S
# OWN renderer rather than by a second implementation of it. The character this
# replaced had its previews emitted as SVG by a script that walked the engine's
# frames and re-drew them by hand — which worked, and which meant every change
# to the renderer had to be made twice or the pictures quietly stopped being of
# the thing they claimed to show.
#
# The orb is drawn with a Canvas and gradients, and there is no honest way to
# re-emit that as SVG. So this runs keystone/IrisBody.qml under Qt's own `qml`
# tool, offscreen, and grabs what it paints: the pictures are the plugin, not a
# drawing of it. The cost is that this needs Qt where the old one needed only
# Node, so it belongs on a desktop rather than in CI — the same place
# tools/coldstart-check belongs, and for the same reason.
#
#   tools/build-preview
#
# Every orb is drawn with reduced motion on, which freezes each state at the
# moment Iris.js marks as the one it reads best at. That is what makes these
# reproducible: run it twice, get the same file.
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
keystone="$here/keystone"

qml_bin=""
for candidate in qml6 qml /usr/lib/qt6/bin/qml; do
  if command -v "$candidate" > /dev/null 2>&1; then qml_bin=$(command -v "$candidate"); break; fi
  if [[ -x $candidate ]]; then qml_bin=$candidate; break; fi
done
[[ -n $qml_bin ]] || { echo "build-preview: needs Qt 6's qml tool (qt6-declarative)" >&2; exit 1; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# The ground these are drawn on. Not a theme's actual colours — a sheet that
# wore one desktop's palette would date the moment that theme changed — but the
# neutral dark the orb is designed against, and one accent so the `theme` tint
# has something to resolve to.
paper="#12121a"
accent="#7aa2f7"

render() {
  local out=$1 columns=$2 cells=$3
  cat > "$work/sheet.qml" <<QML
import QtQuick
import QtQuick.Window

Window {
  id: win
  visible: true
  width: grid.width + 48
  height: grid.height + 48
  color: "$paper"

  property var cells: $cells

  Grid {
    id: grid
    anchors.centerIn: parent
    columns: $columns
    spacing: 20

    Repeater {
      model: win.cells
      delegate: Item {
        required property var modelData
        width: 150
        height: 172

        Loader {
          anchors.horizontalCenter: parent.horizontalCenter
          y: 4
          width: 140
          height: 140
          source: "file://$keystone/IrisBody.qml"
          onLoaded: {
            item.petSize = 108
            item.mood = parent.modelData.mood
            // Being carried is a drag, not a mood the service ever sets on its
            // own, so it is reached the way the desktop reaches it.
            item.dragging = parent.modelData.mood === "dragged"
            item.shellId = parent.modelData.shell
            item.tintId = parent.modelData.tint
            item.temperId = parent.modelData.temper
            item.accent = "$accent"
            item.paper = "$paper"
            item.reduceMotion = true
          }
        }

        Text {
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.bottom: parent.bottom
          anchors.bottomMargin: 4
          text: parent.modelData.caption
          color: "#9a9ab0"
          font.pixelSize: 13
          font.family: "monospace"
        }
      }
    }
  }

  // One frame is not enough: a Canvas paints on the render thread, and grabbing
  // in the same tick as the load returns whatever was there before it. Waiting
  // a beat costs nothing here and is the difference between a sheet of orbs and
  // a sheet of empty squares.
  Timer {
    interval: 1500
    running: true
    onTriggered: {
      grid.grabToImage(function(result) {
        if (!result.saveToFile("$out")) { console.error("could not write $out"); Qt.exit(1) }
        Qt.quit()
      })
    }
  }
}
QML
  QT_QPA_PLATFORM=offscreen QML_DISABLE_DISK_CACHE=1 QT_FORCE_STDERR_LOGGING=1 \
    "$qml_bin" "$work/sheet.qml" 2>&1 | grep -v '^qt\.' >&2 || true
  [[ -s $out ]] || { echo "build-preview: $out was not written" >&2; exit 1; }
}

cell() { # mood shell tint temper caption
  printf '{ mood: "%s", shell: "%s", tint: "%s", temper: "%s", caption: "%s" }' "$@"
}

join() { local IFS=,; echo "$*"; }

# ------------------------------------------------------------- preview.png
#
# What the plugin actually says with this character: one row of the moods it
# reports, one row of the palettes it can wear. A reader who sees only this
# should come away knowing both that the orb answers, and that it is dressable.
moods=(
  "$(cell idle     glass spectrum calm resting)"
  "$(cell working  glass spectrum calm thinking)"
  "$(cell waiting  glass spectrum calm waiting)"
  "$(cell success  glass spectrum calm answered)"
  "$(cell error    glass spectrum calm failed)"
  "$(cell sleeping glass spectrum calm asleep)"
  "$(cell dragged  glass spectrum calm carried)"
)
tints=(
  "$(cell idle glass spectrum calm spectrum)"
  "$(cell idle glass theme    calm theme)"
  "$(cell idle glass ice      calm ice)"
  "$(cell idle glass ember    calm ember)"
  "$(cell idle glass aurora   calm aurora)"
  "$(cell idle glass bloom    calm bloom)"
  "$(cell idle glass mono     calm mono)"
)
render "$here/preview.png" 7 "[$(join "${moods[@]}" "${tints[@]}")]"

# ------------------------------------------------------- docs/tempers.png
#
# The resting tempers, which is the setting a person is most likely to want to
# see before choosing. Eight of them, in the catalogue's own order.
tempers=()
for t in calm attentive lively dreaming deep shy proud restless; do
  tempers+=("$(cell idle glass spectrum "$t" "$t")")
done
render "$here/docs/tempers.png" 4 "[$(join "${tempers[@]}")]"

echo "wrote preview.png and docs/tempers.png"
